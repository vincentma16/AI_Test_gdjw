# 复制本文件为 .env 并按需修改；.env 已被 .gitignore 忽略，不会提交。
#
# 约定：环境相关敏感值放这里，代码通过 os.environ 读取，禁止在
#       config.yaml 或用例中硬编码密钥/token。

# 覆盖 config.yaml 中对应环境的地址（键名：<ENV>_BASE_URL / <ENV>_HOME_URL，全大写）
DEV_HOME_URL=
SIT_HOME_URL=

# 若被测系统需要登录，把账号口令放在这里，并在 config/config.yaml 或
# 用例里用 ${VAR} 占位引用（示例键名，按你的系统自行增删）
# TEST_USERNAME=
# TEST_PASSWORD=
