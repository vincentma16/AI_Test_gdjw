# 复制本文件为 .env 并按需修改；.env 已被 .gitignore 忽略，不会提交。
#
# 约定：环境相关敏感值放这里，代码通过 os.environ 读取，禁止在
#       config.yaml 或用例中硬编码密钥/token。

# 覆盖 config.yaml 中对应环境的 base_url / login_url（键名：<ENV>_XXX，全大写）
# DEV_LOGIN_URL=https://sit.example.com/web/

# 真实登录测试账号（仅测试环境，禁止提交真实生产账号）
# 验证码授权登录：手机号 + 验证码（测试环境固定验证码，无需点获取验证码）
TEST_PHONE=13xxxxxxxxx
TEST_CODE=111111
