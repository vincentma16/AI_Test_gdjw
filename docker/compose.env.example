# 复制本文件为 docker/compose.env（已被 .gitignore 排除，不会提交）。
# 所有值都可以留空——留空表示不覆盖，工程内的 .env / config.yaml 继续生效。
# 优先级：docker/compose.env  >  工程内 .env  >  config.yaml

# ------------------------------------------------------------------
# 构建期（只在 docker compose build 时用到）
# ------------------------------------------------------------------
# 构建期代理。容器内 127.0.0.1 是容器自己，必须用 host.docker.internal
# 不需要代理就留空
BUILD_PROXY=http://host.docker.internal:3067

# 可选 pip 镜像源，官方源慢时填：
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=

# ------------------------------------------------------------------
# 运行期：被测试环境的地址覆盖（键名 = <ENV>_BASE_URL / <ENV>_LOGIN_URL）
# ------------------------------------------------------------------
DEV_BASE_URL=
SIT_BASE_URL=
UAT_BASE_URL=
PROD_BASE_URL=

# ------------------------------------------------------------------
# 运行期：账号凭据（一律占位符化，真实值只在这里和工程 .env 里，不进 git）
# 键名按你的被测系统自行增删；在 config.yaml / 用例里用 ${VAR} 引用
# ------------------------------------------------------------------
TEST_USERNAME=
TEST_PASSWORD=

# ------------------------------------------------------------------
# 运行期：行为开关
# ------------------------------------------------------------------
# 把 api / ui 两次运行归到同一个序号下（runs/<日期>/001/api 与 .../001/ui）
# RUN_SEQ=001
# 保留登录态文件到宿主机（默认 0 = 用完即删，避免真实 token 落盘）
# KEEP_AUTH=0
# 浏览器通道：容器内无系统 Chrome，已默认置空改用 Playwright 内置 chromium。
# 宿主机想切换时填 chrome / msedge
# BROWSER_CHANNEL=

# 报告生成源目录（冒号分隔），默认取最新一次 api + ui 结果
# 想看某次归档：ALLURE_RESULTS_DIRS=/runs/2026-09-24/001/api/allure-results
ALLURE_RESULTS_DIRS=
