# 复制本文件为 .env 并按需修改；.env 已被 .gitignore 忽略，不会提交。
#
# 约定：环境相关敏感值放这里，代码通过 os.environ 读取，禁止在
#       config.yaml 或用例中硬编码密钥/token。

# 覆盖 config.yaml 中对应环境的 base_url（键名：<ENV>_BASE_URL，全大写）
DEV_BASE_URL=https://dev.example.com

# 登录鉴权：config.yaml 的 auth.credentials 与 data/login/login.yaml
# 均以 ${TEST_MOBILE} / ${TEST_CODE} / ${TEST_CLIENT_ID} 占位引用，值在此填写。
TEST_MOBILE=13xxxxxxxxx
TEST_CODE=111111
TEST_CLIENT_ID=your-client-id

# 如有需保护的 token/密钥，在此添加，例如：
# API_TOKEN=
