{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-case.schema.json",
  "title": "Functional Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "preconditions", "steps", "expected_results", "priority", "traceability"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_results": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "type": {
      "type": "string"
    },
    "technique": {
      "type": "string"
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(AC|Q|R|A)-[0-9]{3}$"
      }
    }
  }
}